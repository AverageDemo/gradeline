#!/usr/bin/env sh
# Blocks commits that contain secrets. Enable with: git config core.hooksPath .githooks
set -eu

if ! command -v gitleaks >/dev/null 2>&1; then
  echo "pre-commit: gitleaks is not installed — refusing to commit." >&2
  echo "Install it (https://github.com/gitleaks/gitleaks#installing) and retry." >&2
  exit 1
fi

exec gitleaks git --pre-commit --staged --redact --no-banner --verbose
